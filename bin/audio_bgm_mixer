#!/usr/bin/env python3
"""
YOUAI Cloud Video Factory - Multi-Track Audio & BGM Mastering Mixer (v3.0)
Supports 2-track (voice + bgm) and 3-track (voice + foley + bgm) mixing with
30ms anti-pop fade, automatic BGM ducking, and EBU R128 loudness normalization.
"""
import argparse
import subprocess
import sys
from pathlib import Path


def get_duration(path: Path) -> float:
    out = subprocess.check_output([
        "ffprobe", "-v", "error", "-show_entries", "format=duration",
        "-of", "default=noprint_wrappers=1:nokey=1", str(path)
    ], text=True).strip()
    return float(out) if out else 0.0


def main() -> int:
    parser = argparse.ArgumentParser(description="YOUAI Multi-Track Audio Mixer v3.0")
    parser.add_argument("--voice", required=True, help="Primary voiceover WAV/MP3")
    parser.add_argument("--bgm", required=False, help="Background music track")
    parser.add_argument("--foley", required=False, help="Optional foley track (e.g. marker writing sound)")
    parser.add_argument("--output", "-o", required=True, help="Output mastered WAV/MP3")
    parser.add_argument("--lufs", type=float, default=-16.0, help="Target integrated loudness (LUFS)")
    parser.add_argument("--bgm-vol", type=float, default=0.14, help="BGM relative volume (default 0.14)")
    parser.add_argument("--foley-vol", type=float, default=0.22, help="Foley relative volume (default 0.22)")
    args = parser.parse_args()

    voice = Path(args.voice).resolve()
    out = Path(args.output).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    dur = get_duration(voice)
    fade_out_st = max(0.0, dur - 0.03)

    inputs = ["-i", str(voice)]
    filter_parts = [f"[0:a]aresample=48000,afade=t=in:st=0:d=0.03,afade=t=out:st={fade_out_st:.3f}:d=0.03[v]"]
    mix_inputs = ["[v]"]
    idx = 1

    if args.foley and Path(args.foley).exists():
        inputs.extend(["-stream_loop", "-1", "-i", str(Path(args.foley).resolve())])
        filter_parts.append(f"[{idx}:a]aresample=48000,atrim=0:{dur:.3f},volume={args.foley_vol}[f]")
        mix_inputs.append("[f]")
        idx += 1

    if args.bgm and Path(args.bgm).exists():
        inputs.extend(["-stream_loop", "-1", "-i", str(Path(args.bgm).resolve())])
        bgm_fade = max(0.0, dur - 0.8)
        filter_parts.append(
            f"[{idx}:a]aresample=48000,atrim=0:{dur:.3f},volume={args.bgm_vol},"
            f"afade=t=in:st=0:d=0.3,afade=t=out:st={bgm_fade:.3f}:d=0.8[b]"
        )
        mix_inputs.append("[b]")
        idx += 1

    n_tracks = len(mix_inputs)
    if n_tracks > 1:
        filter_parts.append(
            f"{''.join(mix_inputs)}amix=inputs={n_tracks}:duration=first:dropout_transition=0,"
            f"loudnorm=I={args.lufs}:TP=-1.5:LRA=11[outa]"
        )
    else:
        filter_parts.append(f"[v]loudnorm=I={args.lufs}:TP=-1.5:LRA=11[outa]")

    cmd = [
        "ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
        *inputs,
        "-filter_complex", ";".join(filter_parts),
        "-map", "[outa]", "-ar", "48000", "-ac", "2", str(out)
    ]
    subprocess.run(cmd, check=True)
    print(f"[audio_bgm_mixer] Mastered {n_tracks} track(s) -> {out} (target {args.lufs} LUFS, dur={dur:.2f}s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
