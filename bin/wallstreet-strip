#!/usr/bin/env python3
"""
YOUAI Cloud Video Factory - SOP 01 Evidence Contact Sheet Generator (wallstreet-strip v3.0)
Usage: wallstreet-strip <video_path> <start_s> <end_s> <count> <out.jpg> [cols] [--w 480]
"""
import subprocess
import sys
from pathlib import Path


def main() -> int:
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if len(args) < 5:
        print("Usage: wallstreet-strip <video> <start_s> <end_s> <count> <out.jpg> [cols] [--w 480]", file=sys.stderr)
        return 1

    video = Path(args[0]).resolve()
    start_s = float(args[1])
    end_s = float(args[2])
    count = max(1, int(args[3]))
    out_jpg = Path(args[4]).resolve()
    cols = int(args[5]) if len(args) >= 6 else 4
    rows = (count + cols - 1) // cols

    tile_w = 480
    if "--w" in sys.argv:
        idx = sys.argv.index("--w")
        if idx + 1 < len(sys.argv):
            tile_w = int(sys.argv[idx + 1])

    dur = max(0.5, end_s - start_s)
    fps = count / dur
    out_jpg.parent.mkdir(parents=True, exist_ok=True)

    vf = f"fps={fps:.4f},scale={tile_w}:-1,tile={cols}x{rows}:padding=6:margin=6:color=0x0b0f19"
    cmd = [
        "ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
        "-ss", f"{start_s:.2f}", "-t", f"{dur:.2f}",
        "-i", str(video),
        "-vf", vf, "-frames:v", "1", str(out_jpg)
    ]
    subprocess.run(cmd, check=True)
    print(f"[wallstreet-strip] Generated {cols}x{rows} contact sheet ({count} frames) -> {out_jpg}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
