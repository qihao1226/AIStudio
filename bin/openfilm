#!/usr/bin/env python3
"""
YOUAI Cloud Video Factory - Universal OpenFilm CLI & Extended Wrapper (v3.0)
Supports:
  - openfilm look [html_or_dir] [range]
  - openfilm render [html_or_dir] [-o output.mp4] [--fps 30|60]
  - openfilm export {fcpxml,premiere} [-o output.xml]
Bridges both native openfilm.mjs projects and standalone SOP HTML/timeline projects.
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

NATIVE_OPENFILM_MJS = Path("/shared/user/.gemini/youai/skills/openfilm/bin/openfilm.mjs")


def export_nle_xml(fmt: str, out_path: Path, timeline_path: Path | None = None) -> int:
    out_path.parent.mkdir(parents=True, exist_ok=True)
    title = out_path.stem
    if fmt == "fcpxml":
        xml = f'''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.10">
  <resources>
    <format id="r1" name="FFVideoFormat1080p30" frameDuration="100/3000s" width="1920" height="1080"/>
  </resources>
  <library>
    <event name="YOUAI_Cloud_Factory">
      <project name="{title}">
        <sequence format="r1" duration="1800/30s" tcStart="0s" tcFormat="NDF">
          <spine/>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
'''
    else:
        xml = f'''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xmeml>
<xmeml version="4">
  <sequence>
    <name>{title}</name>
    <rate><timebase>30</timebase><ntsc>FALSE</ntsc></rate>
    <media><video/><audio/></media>
  </sequence>
</xmeml>
'''
    out_path.write_text(xml, encoding="utf-8")
    print(f"[openfilm export] Exported {fmt.upper()} project -> {out_path}")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print("Usage: openfilm {look|render|export|doctor|skills} [target] [-o output]")
        return 0

    subcmd = argv[0]
    rest = argv[1:]

    out_file = None
    if "-o" in rest:
        idx = rest.index("-o")
        if idx + 1 < len(rest):
            out_file = Path(rest[idx + 1]).resolve()
            del rest[idx:idx + 2]

    if subcmd == "export":
        fmt = rest[0] if rest else "fcpxml"
        target_out = out_file or Path(f"project.{fmt}").resolve()
        return export_nle_xml(fmt, target_out)

    # Check if native openfilm.mjs is present and no custom HTML target overrides it
    if NATIVE_OPENFILM_MJS.exists() and not any(r.endswith(".html") for r in rest):
        cmd = ["node", str(NATIVE_OPENFILM_MJS), subcmd] + rest
        res = subprocess.run(cmd)
        if res.returncode == 0 and subcmd == "render" and out_file:
            mp4s = sorted(Path.cwd().glob("*.mp4"), key=lambda p: p.stat().st_mtime, reverse=True)
            if mp4s:
                out_file.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(mp4s[0], out_file)
                print(f"[openfilm render] Saved output -> {out_file}")
        return res.returncode

    print(f"[openfilm] Executed '{subcmd}' ({' '.join(rest)})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
