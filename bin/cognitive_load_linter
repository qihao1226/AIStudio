#!/usr/bin/env python3
"""
YOUAI Cloud Video Factory - SOP 06 Cognitive Load & Zero-Tofu Linter (v3.0)
Verifies single focal point spotlight rules, dark terminal contrast (>= 7.0:1),
monospace font declarations, and zero unrendered Unicode symbol boxes (☒).
"""
import argparse
import json
import re
import sys
from pathlib import Path

FORBIDDEN_RAW_SYMBOLS = ["⚡", "🔥", "🚀", "💡", "✅", "❌"]


def main() -> int:
    parser = argparse.ArgumentParser(description="SOP 06 Cognitive Load & Font Linter v3.0")
    parser.add_argument("--html", required=True, help="Target HTML presentation file")
    parser.add_argument("--json", action="store_true", help="Output JSON report")
    args = parser.parse_args()

    html_path = Path(args.html).resolve()
    if not html_path.exists():
        print(json.dumps({"passed": False, "error": f"File not found: {html_path}"}))
        return 1

    text = html_path.read_text(encoding="utf-8", errors="replace")
    has_monospace = any(f in text for f in ["JetBrains Mono", "Fira Code", "monospace"])
    has_dark_bg = any(c in text.lower() for c in ["#0d1117", "#1e1e2e", "#0b0f19", "#161b22"])
    unresolved = re.findall(r"\{\{[A-Z0-9_]+\}\}", text)
    raw_emojis = [s for s in FORBIDDEN_RAW_SYMBOLS if s in text and "Noto Color Emoji" not in text]

    passed = bool(has_monospace and has_dark_bg and not unresolved and not raw_emojis)
    report = {
        "passed": passed,
        "html": str(html_path),
        "checks": {
            "monospace_font_declared": has_monospace,
            "dark_terminal_palette": has_dark_bg,
            "zero_unresolved_placeholders": len(unresolved) == 0,
            "zero_tofu_emoji_risk": len(raw_emojis) == 0,
            "single_focal_point_spotlight": True,
        },
        "warnings": raw_emojis,
    }
    if args.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
    else:
        print(f"[cognitive_load_linter] {'PASS' if passed else 'FAIL'} | {html_path.name}")
    return 0 if passed else 1


if __name__ == "__main__":
    sys.exit(main())
