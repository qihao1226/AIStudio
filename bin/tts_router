#!/usr/bin/env python3
"""
YOUAI Cloud Video Factory - Universal TTS Tiered Router (tts_router v2.0)
Strictly adheres to user cost/quality hierarchy:
  Tier 1 (High Quality & Free): Colab Kokoro-82M (8 studio voices + word timestamps) or F5-TTS
  Tier 2 (Zero Cost Local Fallback): Piper Neural Offline TTS (instant, 0 network, 0 cost)
  Tier 3 (Emergency Paid Cloud): Gemini API TTS (only when explicitly requested with --engine gemini)
"""
import argparse
import os
import subprocess
import sys
from pathlib import Path

LOCAL_BIN = Path("/home/antigravity/.local/bin")


def main() -> int:
    parser = argparse.ArgumentParser(description="YOUAI Cost-Optimized TTS Router")
    parser.add_argument("--text", help="Text to speak")
    parser.add_argument("--file", help="Text file to read")
    parser.add_argument("--output", "-o", required=True, help="Output WAV path")
    parser.add_argument(
        "--engine",
        choices=["auto", "colab", "kokoro", "index-tts", "voxcpm", "f5-tts", "piper", "gemini"],
        default="auto",
        help="TTS Engine selection (auto: Colab -> Piper fallback; gemini is paid emergency only)"
    )
    parser.add_argument("--voice", help="Voice name or design description (Colab: zm_yunjian/zm_yunxi/zf_xiaobei; Gemini: Charon/Fenrir; Piper: huayan)")
    parser.add_argument("--ref-audio", help="Reference WAV for zero-shot voice cloning")
    parser.add_argument("--speed", type=float, default=1.0, help="Speaking speed multiplier")
    parser.add_argument("--with-timestamps", action="store_true", help="Generate Faster-Whisper word-level timestamps (Colab)")
    args = parser.parse_args()

    text = ""
    if args.text:
        text = args.text
    elif args.file:
        text = Path(args.file).read_text(encoding="utf-8")
    else:
        text = sys.stdin.read()

    text = text.strip()
    if not text:
        print("[tts_router] Error: Empty text", file=sys.stderr)
        return 1

    out_p = Path(args.output).resolve()
    colab_bin = str(LOCAL_BIN / "colab_voice_gen")
    piper_bin = str(LOCAL_BIN / "local_voice_gen")
    gemini_bin = str(LOCAL_BIN / "gemini_tts")

    # Explicit Route: Gemini (User deliberately opted for paid cloud)
    if args.engine == "gemini":
        voice = args.voice or "Charon"
        print(f"[tts_router] [Tier 3 Paid] Explicit Gemini API TTS requested (voice={voice})...")
        cmd = [gemini_bin, "--text", text, "-o", str(out_p), "--voice", voice]
        return subprocess.run(cmd).returncode

    # Route 1: Colab Engines (Kokoro-82M / IndexTTS-2.5 / VoxCPM2 / F5-TTS)
    if args.engine in ("auto", "colab", "kokoro", "index-tts", "voxcpm", "f5-tts"):
        colab_engine = args.engine if args.engine in ("kokoro", "index-tts", "voxcpm", "f5-tts") else "auto"
        voice = args.voice or "zm_yunjian"
        print(f"[tts_router] [Tier 1 Priority] Invoking Colab ({colab_engine}, voice={voice}, speed={args.speed})...")
        cmd = [colab_bin, "--text", text, "-o", str(out_p), "--engine", colab_engine, "--speed", str(args.speed)]
        if colab_engine == "voxcpm" and args.voice:
            cmd.extend(["--voice-design", args.voice])
        else:
            cmd.extend(["--voice", voice])
        if args.ref_audio:
            cmd.extend(["--ref-audio", args.ref_audio])
        if args.with_timestamps:
            cmd.append("--with-timestamps")
        try:
            res = subprocess.run(cmd, timeout=300)
            if res.returncode == 0 and out_p.exists() and out_p.stat().st_size > 0:
                print(f"[tts_router] ✅ Colab voice generation succeeded -> {out_p}")
                return 0
            print("[tts_router] ⚠️ Colab voice unavailable or job returned non-zero code.")
        except Exception as e:
            print(f"[tts_router] ⚠️ Colab voice failed or timed out: {e}")

        if args.engine != "auto":
            print(f"[tts_router] ❌ Engine locked to {args.engine} and generation failed.", file=sys.stderr)
            return 1

    # Route 2: Free Local Offline Piper Fallback (Instant, 0 GPU, 0 network, 0 cost)
    print(f"[tts_router] [Tier 2 Free Fallback] Executing offline Piper Neural TTS (speed={args.speed})...")
    cmd = [piper_bin, "--text", text, "-o", str(out_p), "--speed", str(args.speed)]
    res = subprocess.run(cmd)
    if res.returncode == 0 and out_p.exists() and out_p.stat().st_size > 0:
        print(f"[tts_router] ✅ Piper Offline TTS generated successfully -> {out_p}")
        return 0

    print("[tts_router] ❌ Both Colab free tier and Piper offline fallback failed.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
